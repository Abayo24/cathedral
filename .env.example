# Copy to .env.local (local development) and add the same values in your hosting dashboard.

# --- Sanity CMS (admin dashboard) — find these at https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Public address of the website (used for SEO, sitemap and calendar links)
NEXT_PUBLIC_SITE_URL=https://ststephenscathedralkisumu.org

# Token with "Editor" permission — lets the contact / prayer request form save messages.
# sanity.io/manage → your project → API → Tokens → Add API token
SANITY_API_WRITE_TOKEN=

# Any long random string. Use the same value as the "Secret" of the Sanity webhook
# pointing to https://<your-domain>/api/revalidate so edits appear instantly.
SANITY_REVALIDATE_SECRET=

# Optional: Google Search Console HTML-tag verification code
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
